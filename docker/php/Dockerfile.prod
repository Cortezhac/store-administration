# ==== Etapa 1: dependencias PHP (composer) ====
FROM composer:2 AS vendor

WORKDIR /app
COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts

# ==== Etapa 2: assets del frontend (vite + tailwind + daisyui) ====
FROM node:22-alpine AS assets

WORKDIR /app

# pnpm vía corepack (viene con Node). El 'latest' queda congelado en la capa
# cacheada de la build; si querés reproducibilidad estricta, fijá la versión
# en el campo "packageManager" de package.json.
RUN corepack enable && corepack prepare pnpm@latest --activate

# Solo manifests primero → esta capa se cachea hasta que cambie el lockfile
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Código fuente + recursos → compilación
COPY . .

# Los componentes PHP de maryUI contienen clases Tailwind que @source necesita
# escanear. vendor/ está en .dockerignore así que lo copiamos desde la etapa
# de composer para que Tailwind genere los estilos de los componentes UI.
COPY --from=vendor /app/vendor/robsontenorio/mary/src /app/vendor/robsontenorio/mary/src

RUN pnpm build

# ==== Etapa final: PHP-FPM ====
#
# Versión FIJADA a la patch que corrige CVE-2026-109618 y CVE-2026-109619
# ("PHP2Shell", CVSS 9.2, RCE sin autenticación). El tag flotante
# `php:8.4-fpm-alpine` se mueve solo y no deja evidencia de qué versión
# corría en cada build; el tag con patch explícito sí.
#
#   PHP 8.4 → 8.4.27   (fijo en esta imagen)
#   PHP 8.3 → 8.3.36
#   PHP 8.2 → 8.2.35
#   PHP 8.5 → 8.5.12
#
# Al subir la versión de PHP hay que actualizar también el piso de versión
# en tests/Feature/Security/PhpRuntimeSecurityTest.php y en el gate de
# deploy (deploy.yml).
FROM php:8.4.27-fpm-alpine

RUN apk add --no-cache \
    postgresql-dev \
    libpng-dev \
    libzip-dev \
    zip \
    unzip

RUN docker-php-ext-install pdo pdo_pgsql zip bcmath gd

COPY docker/php/php.ini /usr/local/etc/php/php.ini
COPY docker/php/opcache.ini /usr/local/etc/php/conf.d/opcache.ini

# Hardening del pool de FPM (CVE-2026-109618 / CVE-2026-109619):
# pm.max_requests=1, memory_limit=-1 a nivel de pool y
# session.upload_progress.enabled=off. Se carga después de www.conf
# (orden alfabético) así que sus valores ganan.
COPY docker/php/php-fpm.d/zz-security-hardening.conf /usr/local/etc/php-fpm.d/zz-security-hardening.conf

WORKDIR /var/www/app

COPY . .

# Capa de vendor
COPY --from=vendor /app/vendor /var/www/app/vendor

# Assets compilados por vite. Van a /var/www/app/build-cache (fuera del árbol
# público) porque en runtime public/build es el volumen compartido `store-build`,
# que el entrypoint sincroniza en cada arranque para que store-nginx los sirva.
COPY --from=assets /app/public/build /var/www/app/build-cache

# Permisos base (storage persiste en el volumen store-storage).
# storage/ y bootstrap/cache/ están excluidos del .dockerignore → crearlos aquí.
RUN mkdir -p storage/framework/sessions \
        storage/framework/views \
        storage/framework/cache \
        storage/logs \
        bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

# Descubrimiento de paquetes (Spatie permission, Livewire, Flux, Mary...).
#
# El `composer install` de la etapa de vendor corre con --no-scripts porque ahí
# todavía no existe artisan/, así que el script @php artisan package:discover
# nunca se ejecuta y NO se genera bootstrap/cache/packages.php.
#
# Sin ese manifiesto, los ServiceProvider de los paquetes no se registran:
# el modelo User usaba HasRoles y el login moría con
# "Trait Spatie\Permission\Traits\HasRoles not found".
#
# Corre acá (y no en el entrypoint) para que el manifiesto quede horneado en
# la imagen y no dependa de una escritura en runtime.
RUN php artisan package:discover --ansi

# Entrypoint: valida estructura de storage, sincroniza los assets al volumen
# compartido con nginx y arranca fpm
COPY docker/php/docker-entrypoint.prod.sh /usr/local/bin/docker-entrypoint.prod.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.prod.sh

EXPOSE 9000

ENTRYPOINT ["docker-entrypoint.prod.sh"]
CMD ["php-fpm"]